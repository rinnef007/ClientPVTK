{
  "name": "pvtk-web-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web client (educational/offline) for Phong Van Truyen Ky 2, ported from the J2ME client",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock": "node server/mock-server.mjs",
    "import-assets": "node scripts/import-assets.mjs",
    "gen-protocol": "node scripts/gen-protocol.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "ws": "^8.22.0"
  }
}
